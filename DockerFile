# ==============================================================================
# DOCKERFILE - AI Agent Backend
# ==============================================================================
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p agent_memory agent_logs agent_data agent_secure agent_cache

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

# Run the application
CMD ["python", "api_server.py"]


# ==============================================================================
# DOCKER-COMPOSE.YML - Complete Stack
# ==============================================================================
# Save this as: docker-compose.yml

version: '3.8'

services:
  # AI Agent Backend
  agent:
    build: .
    container_name: ai-agent
    ports:
      - "8000:8000"
    volumes:
      - ./agent_memory:/app/agent_memory
      - ./agent_logs:/app/agent_logs
      - ./agent_data:/app/agent_data
      - ./agent_secure:/app/agent_secure
    environment:
      - AGENT_MODEL=llama3.1:8b
      - AGENT_TEMP=0.7
      - AGENT_MAX_ITER=15
    restart: unless-stopped
    networks:
      - agent-network
    depends_on:
      - ollama

  # Ollama Service (local LLM)
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    ports:
      - "11434:11434"
    volumes:
      - ollama-data:/root/.ollama
    restart: unless-stopped
    networks:
      - agent-network
    # Pull model on startup
    entrypoint: ["/bin/sh", "-c", "ollama serve & sleep 5 && ollama pull llama3.1:8b && wait"]

  # Redis (optional - for caching/sessions)
  redis:
    image: redis:7-alpine
    container_name: agent-redis
    ports:
      - "6379:6379"
    volumes:
      - redis-data:/data
    restart: unless-stopped
    networks:
      - agent-network

  # PostgreSQL (optional - for advanced persistence)
  postgres:
    image: postgres:15-alpine
    container_name: agent-db
    environment:
      POSTGRES_DB: agent_db
      POSTGRES_USER: agent
      POSTGRES_PASSWORD: changeme123
    ports:
      - "5432:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
    restart: unless-stopped
    networks:
      - agent-network

  # Nginx (optional - reverse proxy)
  nginx:
    image: nginx:alpine
    container_name: agent-nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./frontend/build:/usr/share/nginx/html:ro
    restart: unless-stopped
    networks:
      - agent-network
    depends_on:
      - agent

volumes:
  ollama-data:
  redis-data:
  postgres-data:

networks:
  agent-network:
    driver: bridge


